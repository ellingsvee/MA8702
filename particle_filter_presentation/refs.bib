@article{speekenbrink_tutorial_2016,
  title = {A tutorial on particle filters},
  volume = {73},
  issn = {0022-2496},
  url = {https://www.sciencedirect.com/science/article/pii/S002224961630030X},
  doi = {10.1016/j.jmp.2016.05.006},
  abstract = {This tutorial aims to provide an accessible introduction to
              particle filters, and sequential Monte Carlo (SMC) more generally.
              These techniques allow for Bayesian inference in complex dynamic
              state-space models and have become increasingly popular over the
              last decades. The basic building blocks of SMC–sequential
              importance sampling and resampling–are discussed in detail with
              illustrative examples. A final example presents a particle filter
              for estimating time-varying learning rates in a probabilistic
              category learning task.},
  urldate = {2026-03-25},
  journal = {Journal of Mathematical Psychology},
  author = {Speekenbrink, Maarten},
  month = aug,
  year = {2016},
  keywords = {Particle filter, Sequential Bayesian inference, Sequential Monte
              Carlo, State-space model},
  pages = {140--152},
  file = {ScienceDirect Full Text
          PDF:/Users/ellingsv/Zotero/storage/GDZZ2UHE/Speekenbrink - 2016 - A
          tutorial on particle filters.pdf:application/pdf;ScienceDirect
          Snapshot:/Users/ellingsv/Zotero/storage/KYM3L9JC/S002224961630030X.html:text/html
          },
}



@misc{dhayalkar_particle_2025,
  title = {Particle {Filter} {Made} {Simple}: {A} {Step}-by-{Step} {Beginner}
           -friendly {Guide}},
  shorttitle = {Particle {Filter} {Made} {Simple}},
  url = {http://arxiv.org/abs/2511.01281},
  doi = {10.48550/arXiv.2511.01281},
  abstract = {The particle filter is a powerful framework for estimating hidden
              states in dynamic systems where uncertainty, noise, and
              nonlinearity dominate. This mini-book offers a clear and structured
              introduction to the core ideas behind particle filters-how they
              represent uncertainty through random samples, update beliefs using
              observations, and maintain robustness where linear or Gaussian
              assumptions fail. Starting from the limitations of the Kalman
              filter, the book develops the intuition that drives the particle
              filter: belief as a cloud of weighted hypotheses that evolve
              through prediction, measurement, and resampling. Step by step, it
              connects these ideas to their mathematical foundations, showing how
              probability distributions can be approximated by a finite set of
              particles and how Bayesian reasoning unfolds in sampled form.
              Illustrated examples, numerical walk-throughs, and Python code
              bring each concept to life, bridging the gap between theory and
              implementation. By the end, readers will not only understand the
              algorithmic flow of the particle filter but also develop an
              intuitive grasp of how randomness and structure together enable
              systems to infer, adapt, and make sense of noisy observations in
              real time.},
  urldate = {2026-03-25},
  publisher = {arXiv},
  author = {Dhayalkar, Sahil Rajesh},
  month = nov,
  year = {2025},
  note = {arXiv:2511.01281 [stat]},
  keywords = {Statistics - Computation},
  annote = {Comment: 26 pages},
  file = {Preprint PDF:/Users/ellingsv/Zotero/storage/MCPT7ED6/Dhayalkar - 2025
          - Particle Filter Made Simple A Step-by-Step Beginner-friendly
          Guide.pdf:application/pdf;Snapshot:/Users/ellingsv/Zotero/storage/XLUJ236C/2511.html:text/html
          },
}
