

@article{speekenbrink_tutorial_2016,
  title = {A tutorial on particle filters},
  volume = {73},
  issn = {0022-2496},
  url = {https://www.sciencedirect.com/science/article/pii/S002224961630030X},
  doi = {10.1016/j.jmp.2016.05.006},
  abstract = {This tutorial aims to provide an accessible introduction to
              particle filters, and sequential Monte Carlo (SMC) more generally.
              These techniques allow for Bayesian inference in complex dynamic
              state-space models and have become increasingly popular over the
              last decades. The basic building blocks of SMC–sequential
              importance sampling and resampling–are discussed in detail with
              illustrative examples. A final example presents a particle filter
              for estimating time-varying learning rates in a probabilistic
              category learning task.},
  urldate = {2026-03-25},
  journal = {Journal of Mathematical Psychology},
  author = {Speekenbrink, Maarten},
  month = aug,
  year = {2016},
  keywords = {Particle filter, Sequential Bayesian inference, Sequential Monte
              Carlo, State-space model},
  pages = {140--152},
  file = {ScienceDirect Full Text
          PDF:/Users/ellingsv/Zotero/storage/GDZZ2UHE/Speekenbrink - 2016 - A
          tutorial on particle filters.pdf:application/pdf;ScienceDirect
          Snapshot:/Users/ellingsv/Zotero/storage/KYM3L9JC/S002224961630030X.html:text/html
          },
}



@book{sarkka_bayesian_2023,
  address = {Cambridge},
  edition = {2},
  series = {Institute of {Mathematical} {Statistics} {Textbooks}},
  title = {Bayesian {Filtering} and {Smoothing}},
  isbn = {978-1-108-92664-5},
  url = {
         https://www.cambridge.org/core/books/bayesian-filtering-and-smoothing/F88740E8D25010CF3119A5CA379FA37A
         },
  doi = {10.1017/9781108917407},
  abstract = {Now in its second edition, this accessible text presents a unified
              Bayesian treatment of state-of-the-art filtering, smoothing, and
              parameter estimation algorithms for non-linear state space models.
              The book focuses on discrete-time state space models and carefully
              introduces fundamental aspects related to optimal filtering and
              smoothing. In particular, it covers a range of efficient non-linear
              Gaussian filtering and smoothing algorithms, as well as Monte
              Carlo-based algorithms. This updated edition features new chapters
              on constructing state space models of practical systems, the
              discretization of continuous-time state space models, Gaussian
              filtering by enabling approximations, posterior linearization
              filtering, and the corresponding smoothers. Coverage of key topics
              is expanded, including extended Kalman filtering and smoothing, and
              parameter estimation. The book's practical, algorithmic approach
              assumes only modest mathematical prerequisites, suitable for
              graduate and advanced undergraduate students. Many examples are
              included, with Matlab and Python code available online, enabling
              readers to implement algorithms in their own projects.},
  urldate = {2026-04-25},
  publisher = {Cambridge University Press},
  author = {Särkkä, Simo and Svensson, Lennart},
  year = {2023},
  file = {Full Text:/Users/ellingsv/Zotero/storage/U32PYYA6/Särkkä and Svensson
          - 2023 - Bayesian Filtering and
          Smoothing.pdf:application/pdf;Snapshot:/Users/ellingsv/Zotero/storage/6D83VZ7T/F88740E8D25010CF3119A5CA379FA37A.html:text/html
          },
}

